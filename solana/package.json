  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24",
    "chai": "^4.5.0",
    "mocha": "^11.7.0",
    "ts-mocha": "^11.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
