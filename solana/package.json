{
  "name": "@closeby/solana",
  "private": true,
  "description": "Closeby escrow program (Anchor), its tests and the TypeScript client the web uses.",
  "exports": {
    "./client": "./client/index.ts",
    "./idl": "./idl/closeby_escrow.json"
  },
  "scripts": {
    "build": "anchor build --arch v0",
