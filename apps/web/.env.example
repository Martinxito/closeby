# Copy to apps/web/.env.local and fill in. Never commit .env.local.
# These are server-only variables (no NEXT_PUBLIC_ prefix): Next.js never sends them to the browser.

# Supabase → Project Settings → API (project "closeby")
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...) from Project Settings → API Keys. It bypasses RLS, so keep it
# only here and in Vercel's environment variables. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Escrow backend: "mock" (default) until the Solana program is on Devnet, then "chain".
# Both must have the same value. NEXT_PUBLIC_ESCROW_MODE is not a secret.
ESCROW_MODE=mock
NEXT_PUBLIC_ESCROW_MODE=mock

# Login backend: "mock" (default, test users per browser) or "privy".
WALLET_MODE=mock
# Optional: secret for mock session tokens. Defaults to one derived from SUPABASE_SECRET_KEY.
# MOCK_AUTH_SECRET=

# Solana Devnet (server-only). Created by `pnpm --filter @closeby/web setup:devnet`.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Pays fees and rent for users, and is the mint authority of the test USDC. Never NEXT_PUBLIC_.
FEE_PAYER_SECRET_KEY=
# Test USDC mint (our own SPL token, 6 decimals).
USDC_MINT=
# Optional: secret for relay tickets. Defaults to one derived from FEE_PAYER_SECRET_KEY.
# RELAY_TICKET_SECRET=
