# Copy to apps/web/.env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (project "closeby")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon public" key.
# It is public by design; the RLS policies in supabase/migrations/0001_deals.sql protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put the service_role / secret key in the web app.
